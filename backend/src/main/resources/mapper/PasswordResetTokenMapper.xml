<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.agency.sales.mapper.PasswordResetTokenMapper">

  <select id="findByTokenHash" resultType="com.agency.sales.domain.PasswordResetToken">
    SELECT
      id
     ,account_id AS accountId
     ,token_hash AS tokenHash
     ,expires_at AS expiresAt
     ,used_at AS usedAt
     ,created_at AS createdAt
    FROM
      password_reset_tokens
    WHERE
      token_hash = #{tokenHash}
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT
    INTO
      password_reset_tokens
      (
        account_id
       ,token_hash
       ,expires_at
       ,created_at
      )
    VALUES
      (
        #{accountId}
       ,#{tokenHash}
       ,#{expiresAt}
       ,NOW()
      )
  </insert>

  <update id="updateUsedAt">
    UPDATE
      password_reset_tokens
    SET
      used_at = #{usedAt}
    WHERE
      id = #{id}
  </update>

  <delete id="deleteByAccountId">
    DELETE
    FROM
      password_reset_tokens
    WHERE
      account_id = #{accountId}
  </delete>

</mapper>